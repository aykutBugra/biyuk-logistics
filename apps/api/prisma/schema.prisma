model Arac {
  id                Int             @id @default(autoincrement())
  sahipId           Int
  sahip             Kullanici       @relation(fields: [sahipId], references: [id])
  aracKutuphaneId   Int
  aracBilgisi       AracKutuphanesi @relation(fields: [aracKutuphaneId], references: [id])
  plaka             String          @db.VarChar(20) 
  yil               Int
  maksimumAgirlikKg Decimal         @db.Decimal(10, 2)
  maksimumHacimM3   Decimal?
  kasaTipi          String          @default("DIGER") @db.VarChar(50)
  uzunlukCm         Int?
  genislikCm        Int?
  yukseklikCm       Int?
  silmeTarihi       DateTime?
  
  teklifler         Teklif[]
  nakliyeler        Nakliye[]
  capacityReservations VehicleCapacityReservation[]
}

model CarrierRoute {
  id                      Int       @id @default(autoincrement())
  nakliyeciId             Int
  nakliyeci               Kullanici @relation(fields: [nakliyeciId], references: [id])
  baslangicSehri          String    @db.VarChar(100)
  varisSehri              String    @db.VarChar(100)
  baslangicKonumMetni     String?   @db.VarChar(255)
  varisKonumMetni         String?   @db.VarChar(255)
  baslangicProvider       String?   @db.VarChar(50)
  varisProvider           String?   @db.VarChar(50)
  baslangicPlaceId        String?   @db.VarChar(255)
  varisPlaceId            String?   @db.VarChar(255)
  normalizeBaslangicSehir String?   @db.VarChar(100)
  normalizeVarisSehir     String?   @db.VarChar(100)
  normalizeBaslangicIlce  String?   @db.VarChar(100)
  normalizeVarisIlce      String?   @db.VarChar(100)
  baslangicEnlem          Decimal   @db.Decimal(9, 6)
  baslangicBoylam         Decimal   @db.Decimal(9, 6)
  varisEnlem              Decimal   @db.Decimal(9, 6)
  varisBoylam             Decimal   @db.Decimal(9, 6)
  rotaMesafeMetre         Int?
  rotaSureSaniye          Int?
  planlananTarih          String    @db.VarChar(10)
  maksimumSapmaKm         Decimal?  @db.Decimal(10, 2)
  olusturmaTarihi         DateTime  @default(now())
  guncellemeTarihi        DateTime  @updatedAt
  silmeTarihi             DateTime?

  @@index([nakliyeciId, silmeTarihi])
  @@index([planlananTarih])
  @@index([normalizeBaslangicSehir])
  @@index([normalizeVarisSehir])
}



model Istek {
  id                        Int       @id @default(autoincrement())
  musteriId                 Int
  musteri                   Kullanici @relation(fields: [musteriId], references: [id])
  baslangicSehri            String    @db.VarChar(100)
  varisSehri                String    @db.VarChar(100)
  baslangicKonumMetni       String?   @db.VarChar(255)
  varisKonumMetni           String?   @db.VarChar(255)
  baslangicProvider         String?   @db.VarChar(50)
  varisProvider             String?   @db.VarChar(50)
  baslangicPlaceId          String?   @db.VarChar(255)
  varisPlaceId              String?   @db.VarChar(255)
  normalizeBaslangicSehir   String?   @db.VarChar(100)
  normalizeVarisSehir       String?   @db.VarChar(100)
  normalizeBaslangicIlce    String?   @db.VarChar(100)
  normalizeVarisIlce        String?   @db.VarChar(100)
  baslangicEnlem            Decimal   @db.Decimal(9, 6)
  baslangicBoylam           Decimal   @db.Decimal(9, 6)
  varisEnlem                Decimal   @db.Decimal(9, 6)
  varisBoylam               Decimal   @db.Decimal(9, 6)
  rotaMesafeMetre           Int?
  rotaSureSaniye            Int?
  tekTasimaIstiyor          Boolean   @default(false)
  agirlikKg                 Decimal?
  hacimM3                   Decimal?
  yukTipi                   String    @default("GENEL") @db.VarChar(50)
  tasimaTarihi              String?   @db.VarChar(10)
  yukDetay                  String    @db.VarChar(500)
  olusturmaTarihi           DateTime  @default(now())
  silmeTarihi               DateTime?
  durumId                   Int
  durum                     Durum     @relation(fields: [durumId], references: [id])

  teklifler                 Teklif[]
  offerThreads              OfferThread[]
  nakliye                   Nakliye?
  capacityReservations      VehicleCapacityReservation[]
  gorseller                 IstekGorsel[]
}

model IstekGorsel {
  id                  Int      @id @default(autoincrement())
  istekId             Int
  istek               Istek    @relation(fields: [istekId], references: [id])
  storageKey          String   @db.VarChar(500)
  thumbnailStorageKey String   @db.VarChar(500)
  mimeType            String   @db.VarChar(100)
  sizeBytes           Int
  width               Int
  height              Int
  sortOrder           Int
  isPrimary           Boolean  @default(false)
  originalFileName    String   @db.VarChar(255)
  createdAt           DateTime @default(now())
  silmeTarihi         DateTime?

  @@index([istekId, silmeTarihi, sortOrder])
}

model Teklif {
  id              Int       @id @default(autoincrement())
  istekId         Int
  istek           Istek     @relation(fields: [istekId], references: [id])
  nakliyeciId     Int
  nakliyeci       Kullanici @relation(fields: [nakliyeciId], references: [id])
  aracId          Int?
  arac            Arac?     @relation(fields: [aracId], references: [id])
  fiyat           Decimal   @db.Decimal(12, 2)
  not             String?   @db.VarChar(255)
  durumId         Int
  durum           Durum     @relation(fields: [durumId], references: [id])
  offerThread     OfferThread?
  capacityReservations VehicleCapacityReservation[]
}

model OfferThread {
  id                        Int                 @id @default(autoincrement())
  offerId                   Int                 @unique
  offer                     Teklif              @relation(fields: [offerId], references: [id])
  requestId                 Int
  request                   Istek               @relation(fields: [requestId], references: [id])
  customerId                Int
  customer                  Kullanici           @relation("OfferThreadCustomer", fields: [customerId], references: [id])
  carrierId                 Int
  carrier                   Kullanici           @relation("OfferThreadCarrier", fields: [carrierId], references: [id])
  customerLastReadMessageId Int?
  customerLastReadMessage   OfferThreadMessage? @relation("OfferThreadCustomerLastRead", fields: [customerLastReadMessageId], references: [id])
  carrierLastReadMessageId  Int?
  carrierLastReadMessage    OfferThreadMessage? @relation("OfferThreadCarrierLastRead", fields: [carrierLastReadMessageId], references: [id])
  closedAt                  DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  messages                  OfferThreadMessage[] @relation("OfferThreadMessages")

  @@index([requestId])
  @@index([customerId, closedAt])
  @@index([carrierId, closedAt])
}

model OfferThreadMessage {
  id                           Int           @id @default(autoincrement())
  threadId                     Int
  thread                       OfferThread   @relation("OfferThreadMessages", fields: [threadId], references: [id])
  senderUserId                 Int?
  sender                       Kullanici?    @relation("OfferThreadMessageSender", fields: [senderUserId], references: [id])
  type                         String        @db.VarChar(50)
  text                         String?       @db.VarChar(2000)
  teklifFiyati                 Decimal?      @db.Decimal(12, 2)
  systemEventCode              String?       @db.VarChar(100)
  createdAt                    DateTime      @default(now())
  threadsWhereCustomerLastRead OfferThread[] @relation("OfferThreadCustomerLastRead")
  threadsWhereCarrierLastRead  OfferThread[] @relation("OfferThreadCarrierLastRead")

  @@index([threadId, createdAt, id])
  @@index([senderUserId])
}

model Nakliye {
  id              Int       @id @default(autoincrement())
  istekId         Int       @unique
  istek           Istek     @relation(fields: [istekId], references: [id])
  nakliyeciId     Int
  nakliyeci       Kullanici @relation(fields: [nakliyeciId], references: [id])
  aracId          Int
  arac            Arac      @relation(fields: [aracId], references: [id])
  anlasilanFiyat  Decimal   @db.Decimal(12, 2)
  olusturmaTarihi DateTime  @default(now())
  baslangicTarihi DateTime?
  teslimTarihi    DateTime?
  durumId         Int
  durum           Durum     @relation(fields: [durumId], references: [id])

  puanlar         Puanlama[]
  capacityReservations VehicleCapacityReservation[]
}

model VehicleCapacityReservation {
  id                Int       @id @default(autoincrement())
  vehicleId         Int
  vehicle           Arac      @relation(fields: [vehicleId], references: [id])
  shipmentId        Int
  shipment          Nakliye   @relation(fields: [shipmentId], references: [id])
  requestId         Int
  request           Istek     @relation(fields: [requestId], references: [id])
  offerId           Int
  offer             Teklif    @relation(fields: [offerId], references: [id])
  reservedAgirlikKg Decimal?  @db.Decimal(10, 2)
  reservedHacimM3   Decimal?  @db.Decimal(10, 2)
  isDedicated       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  releasedAt        DateTime?
  releaseReason     String?   @db.VarChar(50)

  @@index([shipmentId])
  @@index([vehicleId, releasedAt])
}

model PuanTanimlari {
  id            Int        @id @default(autoincrement())
  puanlamaTuru  String     @db.VarChar(100) // "Sayısal", "Sözel" vb.
  aciklama      String?    @db.VarChar(200)
  
  puanlar       Puanlama[]
}

model Puanlama {
  id              Int           @id @default(autoincrement())
  nakliyeId       Int
  nakliye         Nakliye       @relation(fields: [nakliyeId], references: [id])
  
  puanlayanId     Int
  puanlayan       Kullanici     @relation("PuanVeren", fields: [puanlayanId], references: [id])
  
  puanlananId     Int
  puanlanan       Kullanici     @relation("PuanAlan", fields: [puanlananId], references: [id])
  
  // Hangi puanlama yöntemiyle puan verildi?
  puanTanimId     Int
  puanTuru        PuanTanimlari @relation(fields: [puanTanimId], references: [id])
  
  // Gerçek puan değeri burada (Örn: 4 veya Sözelde 5 karşılığı)
  puanDegeri      Int           
  
  yorum           String?       @db.VarChar(500)
  tarih           DateTime      @default(now())

  @@unique([nakliyeId, puanlayanId, puanlananId])
  @@index([nakliyeId])
  @@index([puanlayanId])
  @@index([puanlananId])
}

model Bildirim {
  id              Int       @id @default(autoincrement())
  kullaniciId     Int
  kullanici       Kullanici @relation(fields: [kullaniciId], references: [id])
  tip             String    @db.VarChar(100)
  baslik          String    @db.VarChar(150)
  mesaj           String    @db.VarChar(300)
  hedefUrl        String?   @db.VarChar(255)
  olayAnahtari    String?   @unique @db.VarChar(200)
  okunmaTarihi    DateTime?
  olusturmaTarihi DateTime  @default(now())

  @@index([kullaniciId, okunmaTarihi, olusturmaTarihi])
}
