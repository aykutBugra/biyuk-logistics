generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Durum {
  id         Int      @id @default(autoincrement())
  durumTuru  String   @db.VarChar(50) 
  durumAdi   String   @db.VarChar(100)
  
  istekler   Istek[]
  teklifler  Teklif[]
  nakliyeler Nakliye[]
}

model Rol {
  id           Int            @id @default(autoincrement())
  rolAd        String         @unique @db.VarChar(100)
  kullanicilar KullaniciRol[]
}

model KullaniciRol {
  id            Int       @id @default(autoincrement())
  rolId         Int
  rol           Rol       @relation(fields: [rolId], references: [id])
  kullaniciId   Int
  kullanici     Kullanici @relation(fields: [kullaniciId], references: [id])
  verilmeTarihi DateTime  @default(now())

  @@unique([kullaniciId, rolId])
}

model Kullanici {
  id               Int            @id @default(autoincrement())
  ad               String         @db.VarChar(100)
  soyad            String         @db.VarChar(100)
  mail             String         @unique @db.VarChar(100)
  kullaniciAdi     String         @unique @db.VarChar(100)
  sifreHash        String
  telefonNumarasi  String?
  customerIntroDismissedAt DateTime?
  carrierIntroDismissedAt  DateTime?
  kayitTarihi      DateTime       @default(now())
  silmeTarihi      DateTime?
  
  roller           KullaniciRol[]
  istekler         Istek[]
  teklifler        Teklif[]
  araclar          Arac[]
  carrierRoutes    CarrierRoute[]
  offerThreadsAsCustomer OfferThread[] @relation("OfferThreadCustomer")
  offerThreadsAsCarrier  OfferThread[] @relation("OfferThreadCarrier")
  offerThreadMessages    OfferThreadMessage[] @relation("OfferThreadMessageSender")
  puanVerenler     Puanlama[]     @relation("PuanVeren")
  puanAlanlar      Puanlama[]     @relation("PuanAlan")
  nakliyeler       Nakliye[]
  bildirimler      Bildirim[]
}










model AracKutuphanesi {
  id      Int    @id @default(autoincrement())
  marka   String @db.VarChar(100)
  model   String @db.VarChar(100)
  
  gercekAraclar Arac[]
}





