model Arac {
  id                Int             @id @default(autoincrement())
  sahipId           Int
  sahip             Kullanici       @relation(fields: [sahipId], references: [id])
  aracKutuphaneId   Int
  aracBilgisi       AracKutuphanesi @relation(fields: [aracKutuphaneId], references: [id])
  plaka             String          @db.VarChar(20)
  yil               Int
  kapasite          Decimal         @db.Decimal(10, 2)
  silmeTarihi       DateTime?
  
  teklifler         Teklif[]
  nakliyeler        Nakliye[]
}



model Istek {
  id              Int       @id @default(autoincrement())
  musteriId       Int
  musteri         Kullanici @relation(fields: [musteriId], references: [id])
  baslangicSehri  String    @db.VarChar(100)
  varisSehri      String    @db.VarChar(100)
  baslangicEnlem  Decimal   @db.Decimal(9, 6)
  baslangicBoylam Decimal   @db.Decimal(9, 6)
  varisEnlem      Decimal   @db.Decimal(9, 6)
  varisBoylam     Decimal   @db.Decimal(9, 6)
  yukDetay        String    @db.VarChar(500)
  olusturmaTarihi DateTime  @default(now())
  silmeTarihi     DateTime?
  durumId         Int
  durum           Durum     @relation(fields: [durumId], references: [id])

  teklifler       Teklif[]
  nakliye         Nakliye?
}

model Teklif {
  id              Int       @id @default(autoincrement())
  istekId         Int
  istek           Istek     @relation(fields: [istekId], references: [id])
  nakliyeciId     Int
  nakliyeci       Kullanici @relation(fields: [nakliyeciId], references: [id])
  aracId          Int?
  arac            Arac?     @relation(fields: [aracId], references: [id])
  fiyat           Decimal   @db.Decimal(12, 2)
  not             String?   @db.VarChar(255)
  durumId         Int
  durum           Durum     @relation(fields: [durumId], references: [id])
}

model Nakliye {
  id              Int       @id @default(autoincrement())
  istekId         Int       @unique
  istek           Istek     @relation(fields: [istekId], references: [id])
  nakliyeciId     Int
  nakliyeci       Kullanici @relation(fields: [nakliyeciId], references: [id])
  aracId          Int
  arac            Arac      @relation(fields: [aracId], references: [id])
  anlasilanFiyat  Decimal   @db.Decimal(12, 2)
  olusturmaTarihi DateTime  @default(now())
  baslangicTarihi DateTime?
  teslimTarihi    DateTime?
  durumId         Int
  durum           Durum     @relation(fields: [durumId], references: [id])

  puanlar         Puanlama[]
}

model PuanTanimlari {
  id            Int        @id @default(autoincrement())
  puanlamaTuru  String     @db.VarChar(100) // "Sayısal", "Sözel" vb.
  aciklama      String?    @db.VarChar(200)
  
  puanlar       Puanlama[]
}

model Puanlama {
  id              Int           @id @default(autoincrement())
  nakliyeId       Int
  nakliye         Nakliye       @relation(fields: [nakliyeId], references: [id])
  
  puanlayanId     Int
  puanlayan       Kullanici     @relation("PuanVeren", fields: [puanlayanId], references: [id])
  
  puanlananId     Int
  puanlanan       Kullanici     @relation("PuanAlan", fields: [puanlananId], references: [id])
  
  // Hangi puanlama yöntemiyle puan verildi?
  puanTanimId     Int
  puanTuru        PuanTanimlari @relation(fields: [puanTanimId], references: [id])
  
  // Gerçek puan değeri burada (Örn: 4 veya Sözelde 5 karşılığı)
  puanDegeri      Int           
  
  yorum           String?       @db.VarChar(500)
  tarih           DateTime      @default(now())

  @@unique([nakliyeId, puanlayanId, puanlananId])
  @@index([nakliyeId])
  @@index([puanlayanId])
  @@index([puanlananId])
}

model Bildirim {
  id              Int       @id @default(autoincrement())
  kullaniciId     Int
  kullanici       Kullanici @relation(fields: [kullaniciId], references: [id])
  tip             String    @db.VarChar(100)
  baslik          String    @db.VarChar(150)
  mesaj           String    @db.VarChar(300)
  hedefUrl        String?   @db.VarChar(255)
  olayAnahtari    String?   @unique @db.VarChar(200)
  okunmaTarihi    DateTime?
  olusturmaTarihi DateTime  @default(now())

  @@index([kullaniciId, okunmaTarihi, olusturmaTarihi])
}
