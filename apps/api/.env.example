# Example configuration only. Contains no real credentials or personal data.
# Copy to apps/api/.env and replace the example-only credentials before use.
# Never deploy with the public JWT placeholders below; generate distinct secrets.

# Server and database (fictional database account)
NEST_PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://example_user:example_password@127.0.0.1:5432/nakliye_example?schema=public
ALLOW_LEGACY_NUMERIC_IDS=false

# Authentication: these public placeholders are NOT secure signing secrets.
JWT_ACCESS_SECRET=example-only-replace-with-a-unique-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=example-only-replace-with-a-unique-random-refresh-secret
JWT_REFRESH_TTL=7d

# Maps: use a server key restricted to the required APIs and server environment.
MAP_PROVIDER=google
ROUTE_ENGINE=google
GOOGLE_MAPS_API_KEY=example-only-not-a-real-server-api-key
MAP_LANGUAGE_CODE=tr
MAP_REGION_CODE=TR

# Media: leave the optional local root empty to use the workspace uploads folder.
MEDIA_DRIVER=local
MEDIA_LOCAL_ROOT=
MEDIA_PUBLIC_BASE_URL=http://localhost:4000

# AI volume estimation: the placeholder below cannot authenticate to the service.
OPENAI_API_KEY=example-only-not-a-real-openai-api-key
OPENAI_VOLUME_ESTIMATION_MODEL=gpt-4.1
OPENAI_VOLUME_ESTIMATION_TIMEOUT_MS=20000
OPENAI_VOLUME_ESTIMATION_MAX_IMAGES=3
OPENAI_VOLUME_ESTIMATION_MAX_FILE_SIZE_MB=5
OPENAI_VOLUME_ESTIMATION_MAX_TOTAL_SIZE_MB=12
OPENAI_VOLUME_ESTIMATION_MAX_IMAGE_DIMENSION_PX=1600
OPENAI_VOLUME_ESTIMATION_JPEG_QUALITY=82
OPENAI_VOLUME_ESTIMATION_RATE_LIMIT_SHORT=3
OPENAI_VOLUME_ESTIMATION_RATE_LIMIT_SHORT_MINUTES=10
OPENAI_VOLUME_ESTIMATION_RATE_LIMIT_DAILY=20
