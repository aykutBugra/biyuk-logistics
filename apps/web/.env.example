# Example configuration only. Contains no real credentials or personal data.
# Copy to apps/web/.env.local and replace the example-only Maps values before use.
# NEXT_PUBLIC_ values are bundled into browser JavaScript and are public.
# Never place database credentials, JWT secrets or server API keys in this file.
# Use a separate browser Maps key restricted by website and required APIs.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=example-only-not-a-real-browser-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=example-only-not-a-real-map-id
